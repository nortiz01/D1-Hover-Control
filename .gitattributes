* text=auto

# Keep source and configuration files usable on Linux when contributors work
# from Windows.
*.py text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.xml text eol=lf
*.launch text eol=lf
*.urdf text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
CMakeLists.txt text eol=lf

# Robot meshes are binary assets.
*.STL binary
